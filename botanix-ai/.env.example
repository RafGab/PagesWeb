# ── Botanix AI · variables de entorno (copiar a .env y rellenar) ──
# Nunca subas .env al repositorio. Ninguna de estas variables se expone al navegador.

# Base de datos PostgreSQL
DATABASE_URL="postgresql://botanix:botanix@localhost:5432/botanix?schema=public"

# URL pública de la app (se usa para comprobar el origen de peticiones y en exportaciones)
APP_URL="http://localhost:3000"

# ── Inteligencia artificial ──
# Proveedor de IA multimodal: "anthropic" (implementado). Sin clave, la app muestra
# instrucciones de configuración en lugar de inventar análisis.
AI_PROVIDER="anthropic"
ANTHROPIC_API_KEY=""
# Modelo (por defecto claude-opus-5-5). Esfuerzo de razonamiento: low | medium | high | xhigh | max
ANTHROPIC_MODEL="claude-opus-5-5"
ANTHROPIC_EFFORT="medium"
# Reintento automático en otro modelo si el principal rechaza una petición (fallbacks del servidor). 1 = activado
ANTHROPIC_SERVER_FALLBACK="1"
AI_TIMEOUT_MS="120000"

# ── Clima y taxonomía ──
# "open-meteo" (sin clave, licencia CC BY 4.0, atribución obligatoria)
CLIMATE_PROVIDER="open-meteo"
# "gbif" (sin clave). Usado para verificar nombres científicos
TAXONOMY_PROVIDER="gbif"

# ── Almacenamiento de fotos ──
# "local": carpeta privada fuera de /public, servida solo al propietario
STORAGE_DRIVER="local"
STORAGE_LOCAL_DIR="./storage"
# Días que se conservan las fotos de análisis que el usuario no guarda en su jardín
IMAGE_RETENTION_DAYS="30"
MAX_UPLOAD_MB="12"

# ── Seguridad ──
# Duración de la sesión en días
SESSION_DAYS="30"
